{
  "name": "buymeabeer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "price:validate": "node scripts/validate-price-data.mjs",
    "price:check-expiry": "node scripts/validate-price-data.mjs --horizon-days=60",
    "payment:validate": "node scripts/validate-payment-config.mjs",
    "build:production": "npm run payment:validate && npm run price:validate && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.36.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.2.2",
    "vitest": "^4.0.15"
  }
}
